# Backend Environment Variables — copy to .env and fill in values
PORT=5000
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://postgres:password@localhost:5432/hospital_rag
DB_SSL=false
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT=30000
DB_POOL_CONNECTION_TIMEOUT=2000

# Groq (backend only — do not expose this key to the frontend)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Knowledge base
KB_DATA_DIR=../data
MAX_RESULTS=5

# Default user UUID for single-user development mode
DEFAULT_USER_ID=00000000-0000-0000-0000-000000000001
